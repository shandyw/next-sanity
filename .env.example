# Public identifiers (not secrets). Create a project/dataset at sanity.io/manage.
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=
# Canonical public origin, e.g. your actual HTTPS domain. Required for production SEO.
SITE_URL=
# Viewer token for authenticated draft previews. SERVER ONLY.
SANITY_API_READ_TOKEN=
# Editor/write token used by the local Node import script only. SERVER ONLY.
SANITY_API_WRITE_TOKEN=
# Development-only sample content. Ignored when NODE_ENV=production.
ENABLE_DEMO_CONTENT=false
# HTTPS adapter endpoints. POST JSON; must return 2xx and {"accepted":true}
# only after durable storage/provider acceptance. Empty means unavailable, never success.
REVIEW_REQUEST_ENDPOINT=
REVIEW_REQUEST_TOKEN=
# Direct MailerLite newsletter integration (server only). Configure both values.
# Integrations > MailerLite API > Use: generate a token and copy the group's ID.
# Enable Account settings > Subscribe settings > Double opt-in for API and integrations.
MAILERLITE_API_TOKEN=
MAILERLITE_GROUP_ID=
# Optional alternative adapter; leave blank when using MailerLite above.
NEWSLETTER_ENDPOINT=
NEWSLETTER_TOKEN=

# Private Studio pricing assistant (SERVER ONLY; never NEXT_PUBLIC).
# Create a separate Sanity dataset with visibility PRIVATE, in the same project.
# The existing public production dataset is refused for private costs/history.
SANITY_PRICING_DATASET=
# Comma-separated personal Sanity user IDs allowed to use pricing. The signed-in
# setup message gives your ID when this list is empty. Not API tokens.
# Users also need private-dataset read/create/update/delete and product draft-write.
PRICING_ADMIN_USER_IDS=
# OpenAI project API key; never shared with Studio/browser code.
# Choose an available model supporting image inputs and Structured Outputs.
OPENAI_API_KEY=
PRICING_AI_MODEL=
